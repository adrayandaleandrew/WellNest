rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // admins/{uid} — presence of a doc grants admin privileges
    // Managed via Firebase Console only (no client writes allowed)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Workouts — readable by all authenticated users, writable by admins only
    match /workouts/{workoutId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Meals — readable by all authenticated users, writable by admins only
    match /meals/{mealId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Users — owner can read/write own doc; admins can read all user docs
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // User subcollections — owner-only read/write; admins can read
    // Covers: workoutLogs, logs (daily activity logs), streak, water, weightLogs, feedback
    match /users/{userId}/{subcollection=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Analytics — admin-only read; written exclusively by Cloud Functions (Admin SDK bypasses rules)
    match /analytics/{document=**} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
